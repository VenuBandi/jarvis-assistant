# Jarvis development settings. Placeholders only. Real secrets go in macOS Keychain (see README).
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8770
JARVIS_DATA_DIR=~/flightops-ai/data/jarvis_app
JARVIS_LOG_LEVEL=INFO
JARVIS_MEMORY=on
JARVIS_ALLOWED_DIRS=
# Development only (prefer Keychain): ANTHROPIC_API_KEY=your-key-here
